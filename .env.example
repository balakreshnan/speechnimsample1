# Required NVIDIA API credential
NVIDIA_API_KEY=

# build.nvidia.com key for hosted streaming gRPC ASR/TTS (usually starts with nvapi-)
NVIDIA_BUILD_API_KEY=

# NVIDIA chat completion service used to answer the transcribed question
NVIDIA_CHAT_BASE_URL=https://inference-api.nvidia.com/v1
NVIDIA_REASONER_MODEL=nvidia/nvidia/cosmos3-super-reasoner

# Native Pipecat voice agent (streaming ASR -> stateful LLM -> streaming TTS)
NVIDIA_AGENT_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_AGENT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AGENT_SPEECH_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_AGENT_ASR_MODEL=nemotron-asr-streaming
NVIDIA_AGENT_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
NVIDIA_AGENT_MULTILINGUAL_ASR_MODEL=parakeet-1.1b-rnnt-multilingual-asr
NVIDIA_AGENT_MULTILINGUAL_ASR_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
NVIDIA_AGENT_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
VOICE_AGENT_VAD_STOP_SECS=0.2

# NVIDIA Magpie multilingual text-to-speech service
NVIDIA_TTS_MODEL=nvidia/nvidia/magpie-tts-multilingual-357m
NVIDIA_TTS_ENDPOINT=https://inference-api.nvidia.com/v1/audio/nvidia/magpie-tts-multilingual-357m/synthesize
NVIDIA_TTS_FALLBACK_ENDPOINT=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize

# Local web server
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
VOICE_AGENT_HOST=127.0.0.1
VOICE_AGENT_PORT=7861
